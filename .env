# Tek Trend Virtual Company - Environment Configuration
# Copy this file to .env and update the values

# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tektrend.com

# Database
DB_HOST=localhost
DB_NAME=tektrend_db
DB_USER=tektrend_user
DB_PASS=secure_password_here
DB_CHARSET=utf8mb4

# Session
SESSION_LIFETIME=1440
SESSION_SECURE=false

# Security
SECRET_KEY=change_this_to_a_random_32_char_string
BCRYPT_ROUNDS=12

# Email (SMTP)
SMTP_HOST=smtp.tektrend.com
SMTP_PORT=587
SMTP_USER=info@tektrend.com
SMTP_PASS=change_this_password
SMTP_ENCRYPTION=tls

# Pagination
ITEMS_PER_PAGE=20
