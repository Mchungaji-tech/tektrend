# Tek Trend Virtual Company - Environment Configuration
# Copy this file to .env and update the values

# Application
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/tektrend
APP_CURRENCY=KSh
APP_CURRENCY_SYMBOL="KSh "

# Database
DB_HOST=localhost
DB_NAME=tektrend
DB_USER='root'
DB_PASS=''
DB_CHARSET=utf8mb4

# Session
SESSION_LIFETIME=1440
SESSION_SECURE=false

# Security
SECRET_KEY=change_this_to_a_random_32_char_string
BCRYPT_ROUNDS=12

# Email (SMTP)
SMTP_HOST=smtp.tektrend.com
SMTP_PORT=587
SMTP_USER=info@tektrend.com
SMTP_PASS=change_this_password
SMTP_ENCRYPTION=tls

# Pagination
ITEMS_PER_PAGE=20
