# Tek Trend — Environment Configuration
# Copy this file to ".env" and fill in the real values.
#   Windows (PowerShell):  Copy-Item .env.example .env
# Never commit the real ".env" to git.

APP_ENV=production
APP_DEBUG=false

# Leave APP_URL unset to auto-detect the current host/scheme (recommended for local XAMPP).
# In production you can pin it, e.g. APP_URL=https://tektrend.co.ke
# APP_URL=

# Database (matches the app defaults if omitted)
DB_HOST=localhost
DB_NAME=tektrend
DB_USER=root
DB_PASS=

# ---------------------------------------------------------------------------
# Google OAuth 2.0  ->  "Sign in with Google"
# Create credentials at: https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorized JavaScript origins:  <your site origin, e.g. http://localhost  or  https://yourdomain.com>
#   Authorized redirect URIs:       <the EXACT value shown on your /login page footer / the callback URI>
#                                   e.g. http://localhost/auth/google/callback
#                                   e.g. https://yourdomain.com/auth/google/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: only allow sign-ins from this Google Workspace domain (leave blank to allow any verified email)
GOOGLE_ALLOWED_DOMAIN=

# ---------------------------------------------------------------------------
# GitHub OAuth 2.0  ->  "Sign in with GitHub"
# Create an OAuth App at: https://github.com/settings/applications/new
#   Application name:        Tek Trend
#   Homepage URL:            <your site, e.g. http://localhost  or  https://yourdomain.com>
#   Authorization callback URL: <the EXACT callback URI shown on your /login page>
#                                   e.g. http://localhost/auth/github/callback
#                                   e.g. https://yourdomain.com/auth/github/callback
# After saving, generate a "Client secret" and copy both values below.
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: comma-separated email domains allowed to auto-create accounts (leave blank to allow any verified email)
GITHUB_ALLOWED_DOMAIN=

# ---------------------------------------------------------------------------
# Online Meetings  ->  embedded Jitsi Meet (rooms are generated by the backend)
# JITSI_DOMAIN is the server that carries the actual audio/video.
#   Default: meet.jit.si (free public Jitsi, fastest to ship)
#   Later:   set to your self-hosted Jitsi VPS, e.g. meet.tektrend.co.ke
# JITSI_ROOM_PREFIX namespaces every room name (alphanumeric, keep it short).
# ---------------------------------------------------------------------------
JITSI_DOMAIN=meet.jit.si
JITSI_ROOM_PREFIX=tektrend
