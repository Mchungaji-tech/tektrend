# Tek Trend — Environment Configuration
# Copy this file to ".env" and fill in the real values.
#   Windows (PowerShell):  Copy-Item .env.example .env
# Never commit the real ".env" to git.

APP_ENV=production
APP_DEBUG=false

# Leave APP_URL unset to auto-detect the current host/scheme (recommended for local XAMPP).
# In production you can pin it, e.g. APP_URL=https://tektrend.co.ke
# APP_URL=

# Database (matches the app defaults if omitted)
DB_HOST=localhost
DB_NAME=tektrend
DB_USER=root
DB_PASS=

# ---------------------------------------------------------------------------
# Google OAuth 2.0  ->  "Sign in with Google"
# Create credentials at: https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorized JavaScript origins:  <your site origin, e.g. http://localhost  or  https://yourdomain.com>
#   Authorized redirect URIs:       <the EXACT value shown on your /login page footer / the callback URI>
#                                   e.g. http://localhost/callback.php
#                                   e.g. https://yourdomain.com/callback.php
#                                   e.g. https://yourdomain.com/auth/google/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: explicitly set custom redirect URI if different from auto-detected
GOOGLE_REDIRECT_URI=

# Optional: only allow sign-ins from this Google Workspace domain (leave blank to allow any verified email)
GOOGLE_ALLOWED_DOMAIN=

# ---------------------------------------------------------------------------
# GitHub OAuth 2.0  ->  "Sign in with GitHub"
# Create an OAuth App at: https://github.com/settings/applications/new
#   Application name:        Tek Trend
#   Homepage URL:            <your site, e.g. http://localhost  or  https://yourdomain.com>
#   Authorization callback URL: <the EXACT callback URI shown on your /login page>
#                                   e.g. http://localhost/auth/github/callback
#                                   e.g. https://yourdomain.com/auth/github/callback
# After saving, generate a "Client secret" and copy both values below.
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: comma-separated email domains allowed to auto-create accounts (leave blank to allow any verified email)
GITHUB_ALLOWED_DOMAIN=

# ---------------------------------------------------------------------------
# Online Meetings  ->  Google Meet links (auto-created via a Google Calendar event)
# When a consultation/meeting is booked, the backend creates a Google Calendar event
# with a Meet conference and stores its https://meet.google.com/... join link.
# Setup (one-time, free):
#   1. Google Cloud project -> enable the "Google Calendar API".
#   2. Create a "Service account" -> create and download its JSON key.
#   3. Put the JSON somewhere OUTSIDE the web root (never in /public) and set
#      GOOGLE_MEET_KEY_FILE, or paste client_email + private key into the two vars.
# A Google Workspace account with Meet enabled is the most reliable for programmatic
# conference creation. IMPORTANT: the private key stays on the server only.
# ---------------------------------------------------------------------------
GOOGLE_MEET_ENABLED=true
GOOGLE_MEET_KEY_FILE=
GOOGLE_MEET_CLIENT_EMAIL=
GOOGLE_MEET_PRIVATE_KEY=
GOOGLE_MEET_CALENDAR_ID=primary
GOOGLE_MEET_TIMEZONE=Africa/Nairobi

# ---------------------------------------------------------------------------
# Paystack Payment Gateway  ->  Checkout for code licenses, turnkey packages, and invoices
# Get your API keys at: https://dashboard.paystack.com/#/settings/developer
# Public key is used in frontend inline checkout; Secret key stays ONLY on server.
# ---------------------------------------------------------------------------
PAYSTACK_PUBLIC_KEY=pk_test_
PAYSTACK_SECRET_KEY=sk_test_
PAYSTACK_CURRENCY=KES

